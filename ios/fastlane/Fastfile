default_platform(:ios)

platform :ios do
  desc "Build and upload a new beta build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )

    # Build the Flutter release archive from the repo root.
    sh("unset BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_PATH GEM_HOME GEM_PATH RUBYLIB RUBYOPT && eval \"$(rbenv init -)\" && cd .. && flutter build ios --release --no-codesign --no-pub")

    # Build the signed IPA.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      xcargs: "PROVISIONING_PROFILE_SPECIFIER=\"Geez Marketplace AppStore\"",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "PRRHAU487P",
        provisioningProfiles: {
          "com.geez.script" => "Geez Marketplace AppStore"
        },
        signingStyle: "manual"
      },
      output_directory: "./build",
      output_name: "GeezMarketplace.ipa",
      clean: true
    )

    # Upload to TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
